# Smartup Hub: переменные окружения (ТЗ, раздел 13.5).
# Скопируйте файл в .env и задайте значения. Файл .env в репозиторий не попадает.
# Состав проверяет src/env.ts: сервер с неверным значением не запускается.

# Режим работы: development, test или production. Next.js задаёт его сам.
NODE_ENV=development

# Адрес портала: схема, узел и порт. http допускается только для localhost и 127.0.0.1.
HUB_URL=http://localhost:3000
# Имя узла из HUB_URL.
HUB_DOMAIN=localhost

# Подключение приложения к базе. Пользователь строго hub_app (без права обходить политики RLS).
DATABASE_URL_APP=postgres://hub_app:change-me-app@127.0.0.1:5432/hub
# Подключение библиотеки аутентификации. Пользователь строго hub_auth.
DATABASE_URL_AUTH=postgres://hub_auth:change-me-auth@127.0.0.1:5432/hub

# Подключение владельца схемы. Его читают только миграции (pnpm db:migrate).
DATABASE_URL_OWNER=postgres://hub_owner:change-me-owner@127.0.0.1:5432/hub
# Подключение суперпользователя. Его читает только начальная настройка базы (pnpm db:bootstrap):
# она создаёт роли hub_owner, hub_app, hub_auth с паролями из трёх адресов выше.
DATABASE_URL_SUPERUSER=postgres://postgres:change-me-superuser@127.0.0.1:5432/postgres
# Пароль суперпользователя для контейнера базы (compose.yaml). Тот же, что в адресе выше.
POSTGRES_PASSWORD=change-me-superuser
# Образ базы, если Docker Hub недоступен, например mirror.gcr.io/pgvector/pgvector:pg18.
# PG_IMAGE=pgvector/pgvector:pg18

# Секрет подписи сессий, не короче 32 знаков. Команда pnpm dev:up создаёт случайный.
BETTER_AUTH_SECRET=change-me-session
# Ключ шифрования секретов в базе: 32 случайных байта в base64 (openssl rand -base64 32).
# Команда pnpm dev:up создаёт случайный. Потеря ключа означает потерю секретов серверов Smartup.
ENCRYPTION_KEY=change-me-encryption

# Письма со ссылками входа: none (не отправлять), console (печатать в журнал), file (класть в каталог)
# или resend (настоящая отправка, решение 0018). Значения console и file работают только на localhost:
# ссылка для входа это секрет.
MAIL_TRANSPORT=console
# Каталог писем для значения file.
# MAIL_FILE_DIR=.mail
# Для значения resend: ключ API (секрет) и отправитель, адрес или вид "Имя <адрес>" с проверенного домена.
# RESEND_API_KEY=
# MAIL_FROM=Smartup Hub <hub@mail.smartup24.com>

# Проверка "не робот" на формах входа (Cloudflare Turnstile, решение 0018). Ключи задаются парой.
# Без них проверка выключена. Ключ сайта публичный, секрет хранится только на сервере.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# Бот Telegram (решение 0018): привязка аккаунта и запасной вход. Токен от @BotFather и секрет вебхука
# (32-256 знаков: латинские буквы, цифры, _ и -) задаются парой. Без них бот выключен.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# Адрес Bot API. Другое значение только на localhost: ложный Telegram для разработки (pnpm dev:telegram).
# TELEGRAM_API_URL=https://api.telegram.org

# Заголовок с адресом посетителя для счётчиков частоты и журнала аудита. За Cloudflare: cf-connecting-ip.
# На localhost можно не задавать (x-forwarded-for). На настоящем адресе в production обязателен.
# CLIENT_IP_HEADER=cf-connecting-ip

# Хранилище вложений (решение 0027): local (каталог на диске, только localhost) или r2 (Cloudflare R2).
# На настоящем адресе в production обязательно r2.
FILE_STORAGE=local
# Каталог файлов для значения local.
# FILE_STORAGE_DIR=.storage
# Для значения r2: адрес S3 вида https://<счёт>.r2.cloudflarestorage.com, бакет и ключ API с правом на бакет (секрет).
# R2_ENDPOINT=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Витрина компонентов по адресу /ru/dev/ui: 0 или 1. В production включается только на localhost.
HUB_SHOWCASE=0

# Уровень журнала: debug, info, warn или error.
LOG_LEVEL=info

# Команды, которые не читает сам портал (проверка main, C3):
# секрет клиента OAuth для hub server:add (иначе команда спросит его без отображения на экране);
# HUB_OAUTH_CLIENT_SECRET=
# имя базы и пароли ролей для начальной настройки (scripts/db/bootstrap.mjs). Без паролей они берутся
# из адресов DATABASE_URL_OWNER, DATABASE_URL_APP и DATABASE_URL_AUTH.
# HUB_DB_NAME=hub
# HUB_OWNER_PASSWORD=
# HUB_APP_PASSWORD=
# HUB_AUTH_PASSWORD=
