# Caddy по разделу 13.4 ТЗ. Перед ним Cloudflare (Full strict).
# Content-Security-Policy ставит само приложение (src/proxy.ts): в нём одноразовый код запроса.

{$HUB_DOMAIN} {
	# Отвечаем только доверенным адресам (план W0, задача 6; аудит 23.11.2026, находка S3): по умолчанию это адреса
	# Cloudflare из compose.prod.yaml. Запрос в обход Cloudflare получает 403, поэтому заголовку CF-Connecting-IP
	# (CLIENT_IP_HEADER, решение 0020) можно верить и без сетевого экрана хостинга. Экран остаётся вторым слоем.
	@untrusted not remote_ip {$TRUSTED_PROXIES}
	respond @untrusted 403

	# TRACE и TRACK портал не поддерживает (ASVS 5.0.0, требование 13.4.4): отказ здесь, Next.js ответил бы ошибкой 500.
	@trace method TRACE TRACK
	respond @trace 405

	# Журнал доступа строками JSON (ТЗ 13.8): время ответа каждого запроса. Секреты и адреса с токенами в журнал
	# не пишутся: одноразовые значения из адреса запроса вырезаются, заголовки с секретом вебхука Telegram и подписью
	# вебхука почты удаляются, Referer и Location удаляются целиком (в них бывает адрес страницы с ?token=).
	# Cookie и Authorization Caddy вырезает сам.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					replace token REDACTED
					replace code REDACTED
					replace state REDACTED
				}
				request>headers>X-Telegram-Bot-Api-Secret-Token delete
				request>headers>Svix-Signature delete
				request>headers>Referer delete
				resp_headers>Location delete
			}
		}
	}

	encode zstd gzip
	# Файлы пойдут напрямую в хранилище, мимо портала.
	request_body {
		max_size 2MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# "?": только если портал не задал свой. Страницы виджета отвечают no-referrer (план M6), его Caddy не трогает.
		?Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	# Копии портала (аудит 23.11.2026, находка O6): по умолчанию одна, вторая добавляется переменной
	# HUB_UPSTREAMS="web:3000 web2:3000". Caddy сам проверяет готовность каждой копии и не шлёт запросы той, что не
	# готова. Если копия не приняла соединение (перезапуск при выкладке), запрос за 5 секунд уходит на другую.
	reverse_proxy {$HUB_UPSTREAMS:web:3000} {
		lb_policy least_conn
		lb_try_duration 5s
		lb_try_interval 250ms
		fail_duration 10s
		health_uri /api/ready
		health_interval 5s
		health_timeout 3s
	}
}
