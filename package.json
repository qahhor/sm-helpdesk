{
  "name": "smartup-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/start-standalone.mjs",
    "typecheck": "node scripts/next.mjs typegen && tsc --noEmit",
    "lint": "eslint",
    "check": "pnpm typecheck && pnpm lint && node scripts/checks/run-all.mjs",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:bootstrap": "node --env-file-if-exists=.env scripts/db/bootstrap.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/db/migrate.mjs",
    "test:e2e": "playwright test --trace off",
    "fonts:build": "node scripts/fonts/build.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@formatjs/icu-messageformat-parser": "3.5.23",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "fontkit": "3.0.0",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.5",
    "testcontainers": "12.2.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
