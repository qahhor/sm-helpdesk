{
  "name": "smartup-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev:up": "node scripts/dev-up.mjs",
    "dev": "node scripts/next.mjs dev",
    "build": "node scripts/next.mjs build && node scripts/build-cli.mjs",
    "start": "node scripts/start-standalone.mjs",
    "typecheck": "node scripts/next.mjs typegen && tsc --noEmit",
    "lint": "eslint",
    "check": "pnpm typecheck && pnpm lint && node scripts/checks/run-all.mjs",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "eval:search": "vitest run --project eval --silent=false tests/eval/search.test.ts",
    "eval:ai": "vitest run --project eval --silent=false tests/eval/ai.test.ts",
    "db:bootstrap": "node --env-file-if-exists=.env scripts/db/bootstrap.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/db/migrate.mjs",
    "test:e2e": "playwright test --trace off",
    "fonts:build": "node scripts/fonts/build.mjs",
    "budget": "node scripts/checks/bundle-budget.mjs",
    "lighthouse": "lhci collect && lhci assert",
    "build:cli": "node scripts/build-cli.mjs",
    "hub": "node scripts/build-cli.mjs && node --env-file-if-exists=.env dist/hub.mjs",
    "dev:oidc": "node scripts/mock-oidc.mjs",
    "dev:telegram": "node scripts/mock-telegram.mjs",
    "dev:tracker": "node scripts/mock-tracker.mjs",
    "dev:host": "node --env-file-if-exists=.env scripts/mock-smartup-host.mjs",
    "widget:build": "node scripts/widget-build.mjs"
  },
  "dependencies": {
    "@better-auth/sso": "1.7.22",
    "@formatjs/icu-messageformat-parser": "3.5.23",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-bold": "3.34.0",
    "@tiptap/extension-code": "3.34.0",
    "@tiptap/extension-document": "3.34.0",
    "@tiptap/extension-hard-break": "3.34.0",
    "@tiptap/extension-heading": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-italic": "3.34.0",
    "@tiptap/extension-link": "3.34.0",
    "@tiptap/extension-list": "3.34.0",
    "@tiptap/extension-paragraph": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/extension-text": "3.34.0",
    "@tiptap/extensions": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.22",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "get-nonce": "1.0.1",
    "jose": "6.2.17",
    "kysely": "0.29.9",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "parse5": "8.1.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "undici": "8.12.4",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "fontkit": "3.0.0",
    "oauth2-mock-server": "9.3.0",
    "rolldown": "1.2.19",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.5",
    "testcontainers": "12.2.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
